{
  "name": "zero-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run animation:generate && npm run animation:validate && node scripts/fetch-rigby-runtime.mjs && vite build",
    "test": "node --test",
    "lint": "eslint .",
    "preview": "vite preview",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "art:validate": "node scripts/validate-original-png-art.mjs",
    "art:prepare-reference": "node scripts/prepare-reference-enemy-art.mjs",
    "art:generate": "node scripts/validate-original-png-art.mjs",
    "animation:validate": "node scripts/validate-rig-roster.mjs",
    "animation:generate": "node scripts/generate-rigby-rigs.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.6",
    "@capacitor/cli": "^7.4.3"
  }
}
